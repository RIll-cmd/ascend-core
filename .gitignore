# ==============================================================================
# Ascend Core - Root .gitignore
# ==============================================================================

# Node Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Frontend Build Artifacts & Next.js
.next/
client/.next/
out/
client/out/
build/
client/build/
dist/
client/dist/
.vercel/
client/.vercel/
*.tsbuildinfo
next-env.d.ts
.turbo/
.cache/
tmp/
temp/
coverage/
client/coverage/

# Python & Virtual Environments
*venv*/
venv/
.venv/
env/
ENV/
server/*venv*/
server/venv/
server/.venv/
server/venv311/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Local SQLite & Cache Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
server/dev.db
server/dev.db-journal
server/prisma/dev.db
server/prisma/dev.db-journal

# Environment & Secret Files (Strict Blacklist)
.env
.env.local
.env.development
.env.test
.env.production
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!**/.env.example

# Neon Project Context Cache
.neon
.neon.*
**/.neon
**/.neon.*

# Certificates, Keys & Private Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub

# Scratch, Debug Scripts & Temporary Testing Dumps
scratch/
**/scratch/
server/debug_imports.py

# Local Tooling & Editor Files
.worktrees/
.playwright-mcp/
.impeccable/
.cursor/
.cursorrules
.claude/
.codex*
.superpowers/
.agents/
.agent/
.agentskills/
skills-lock.json
CLAUDE.md
AGENTS.md
docs/superpowers/
.vscode/
.idea/

# Temporary Screenshots & Visual Dumps
/*.png
/*.gif
**/.tmp-*

# OS & System Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
