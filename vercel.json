{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev && npm ci --prefix client --include=dev",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/status-sweep",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/midnight-decay",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://ascend-os-server.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ascend-os-server.onrender.com/api/:path*"
    }
  ]
}
