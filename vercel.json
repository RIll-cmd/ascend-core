{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/.next",
  "installCommand": "npm install --prefix client",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/status-sweep",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/midnight-decay",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30
    }
  }
}
