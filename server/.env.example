# Local development PostgreSQL. Copy this file to .env and adjust credentials
# if your PostgreSQL installation requires them.
DATABASE_URL="postgresql://localhost:5432/ascend"
DATABASE_URL_UNPOOLED="postgresql://localhost:5432/ascend"

# Production uses Neon. See .env.production.example for non-secret placeholders.

# AI & External Services
GEMINI_API_KEY="your_gemini_api_key_here"
RESEND_API_KEY="your_resend_api_key_here"
INTEGRATION_API_KEY="replace-with-a-long-random-secret"
