# Local development PostgreSQL. Copy this file to .env and adjust credentials
# if your PostgreSQL installation requires them.
DATABASE_URL="postgresql://localhost:5432/ascend"
DATABASE_URL_UNPOOLED="postgresql://localhost:5432/ascend"

# Production uses Neon.

# Security (SECRET_KEY and CRON_SECRET are required in production)
SECRET_KEY="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"

# AI & External Services
GEMINI_API_KEY="your_gemini_api_key_here"
INTEGRATION_API_KEY="replace-with-a-long-random-secret"
GUEST_ACCESS_PASSWORD="set-the-private-guest-password-here"

# Email OTP delivery
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""
