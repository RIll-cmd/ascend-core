// This is your Prisma schema file for Ascend OS (SaaS MVP Skeleton)

generator pyclient {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum HabitType {
  POSITIVE
  NEGATIVE
}


model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String?  @unique
  password        String?
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  character       Character?
  emailTokens     EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String?
  theme     String?
  title     String?
  level     Int      @default(1)
  exp       Int      @default(0)
  currentHp Int      @default(100)
  maxHp     Int      @default(100)
  power     Int      @default(0)
  rank      String   @default("F")
  gold      Int      @default(0)
  gems      Int      @default(0)
  towerTokens Int    @default(0)
  availableSP Int    @default(0)
  highestTowerFloor Int @default(0)
  activeTitleId String?
  specializationId String?
  specialization ClassSpecialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  streakFreezes Int    @default(0)
  timezone      String? @default("UTC")
  lastDecayCheck DateTime?
  dailyStepGoal Int    @default(10000)
  dailySteps    Int    @default(0)
  createdAt DateTime @default(now())

  stats         CharacterStats?
  history       ProgressHistory[]
  habits        Habit[]
  missions      Mission[]
  achievements  CharacterAchievement[]
  economyLogs   EconomyLog[]
  towerProgress         FloorProgress[]
  towerProgresses       TowerProgress[]
  playerItems           PlayerItem[]
  inventoryTransactions InventoryTransaction[]
  playerSkills          PlayerSkill[]
  characterTitles       CharacterTitle[]
  dailySnapshots        DailyCompletionSnapshot[]

  workoutSessions WorkoutSession[]
  weeklyBosses    WeeklyBoss[]
  bosses          Boss[]
  activeBuffs     ActiveBuff[]
  seasonProgresses CharacterSeasonProgress[]
  equippedBeastId  String?
  eggs             Egg[]
  beasts           Beast[]
  dailyStepLogs    DailyStepLog[]
  muscleRecoveryStates MuscleRecoveryState[]
  relapseLogs         HabitRelapseLog[]
  integrationObservations IntegrationObservation[]
  automationRules     AutomationRule[]
  automationExecutions AutomationExecution[]
}

model CharacterStats {
  id          String    @id @default(uuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  strength    Int @default(1)
  knowledge   Int @default(1)
  discipline  Int @default(1)
  focus       Int @default(1)
  endurance   Int @default(1)
  recovery    Int @default(1)
  consistency Int @default(1)
}

model ProgressHistory {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now())
}

model IntegrationObservation {
  id          String    @id @default(uuid())
  eventId     String    @unique
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  source      String
  eventType   String
  observedAt  DateTime
  payloadJson String
  createdAt   DateTime  @default(now())
  automationExecutions AutomationExecution[]

  @@index([characterId, observedAt])
  @@index([characterId, eventType, observedAt])
}

model AutomationRule {
  id              String                @id @default(uuid())
  characterId     String
  character       Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean               @default(true)
  triggerType     String
  matchMode       String                @default("all")
  conditionsJson  String                @default("[]")
  actionsJson     String
  cooldownSeconds Int                   @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  executions      AutomationExecution[]

  @@index([characterId, triggerType, enabled])
}

model AutomationExecution {
  id            String                 @id @default(uuid())
  ruleId        String
  rule          AutomationRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  observationId String
  observation   IntegrationObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  status        String
  executedAt    DateTime               @default(now())
  resultJson    String                 @default("{}")

  @@unique([ruleId, observationId])
  @@index([characterId, executedAt])
}

model Habit {
  id            String    @id @default(uuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  icon          String?
  color         String?
  category      String
  difficulty    String    // 'EASY', 'MEDIUM', 'HARD'
  primaryStat   String
  status        String    @default("ACTIVE") // 'ACTIVE', 'PAUSED', 'ARCHIVED', 'DELETED'
  scheduleType  String    @default("DAILY") // 'DAILY', 'SPECIFIC_DAYS', 'X_TIMES_WEEK', 'MONTHLY', 'CUSTOM'
  rrule         String?
  streak        Int       @default(0)
  bestStreak    Int       @default(0)
  preferredTime String?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pausedAt      DateTime?
  archivedAt    DateTime?
  type          HabitType @default(POSITIVE)
  affectedStat  String    @default("HP")
  statModifier  Int       @default(10)
  relapseCount  Int       @default(0)
  streakDays    Int       @default(0)
  lastTriggeredAt DateTime?

  schedule HabitSchedule?
  metrics  HabitMetrics?
  tiers    HabitTier[]
  missions Mission[]
  relapseLogs HabitRelapseLog[]
}

model HabitRelapseLog {
  id            String   @id @default(uuid())
  habitId       String
  habit         Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  affectedStat  String
  requestedAmount Int
  actualAmount  Int
  previousValue Int
  newValue      Int
  createdAt     DateTime @default(now())

  @@index([characterId, createdAt])
}

model DailyCompletionSnapshot {
  id             String    @id @default(uuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  date           DateTime
  completedCount Int       @default(0)
  totalCount     Int       @default(0)
  completionRate Float     @default(0.0)
  createdAt      DateTime  @default(now())

  @@unique([characterId, date])
}

model HabitSchedule {
  id            String    @id @default(uuid())
  habitId       String    @unique
  habit         Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  daysOfWeek    String?   // JSON array string for specific days e.g. ["Monday", "Wednesday"]
  timesPerWeek  Int?
  timesPerMonth Int?
  startTime     String?
  endTime       String?
  timezone      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

model HabitTier {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tier        String   // 'MINI', 'NORMAL', 'ELITE'
  targetType  String?
  targetValue Float?
  targetUnit  String?
  baseExp     Int      @default(0)
  baseGold    Int      @default(0)
  statReward  Int      @default(0)

  @@unique([habitId, tier])
}

model HabitMetrics {
  id                 String @id @default(uuid())
  habitId            String @unique
  habit              Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitStrength      Float  @default(100.0)
  successRate        Float  @default(0.0)
  completionRate     Float  @default(0.0)
  currentConsistency Float  @default(0.0)
}

model Mission {
  id             String    @id @default(uuid())
  habitId        String?
  habit          Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String    @default("PENDING") // 'PENDING', 'COMPLETED', 'MISSED'
  completionType String? // 'MINI', 'NORMAL', 'ELITE'
  expEarned      Int?
  statsEarned    Int?
  completedAt    DateTime?
}

model Achievement {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String   // 'HABITS', 'WORKOUT', 'TOWER', 'SOCIAL'
  icon          String   // e.g. '/icons/Icon12.png'
  targetValue   Int      @default(1)
  rewardGold    Int      @default(0)
  rewardGems    Int      @default(0)
  rewardTitleId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  characterAchievements CharacterAchievement[]
}

model CharacterAchievement {
  id              String      @id @default(uuid())
  characterId     String
  character       Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  currentProgress Int         @default(0)
  isClaimed       Boolean     @default(false)
  unlockedAt      DateTime?

  @@unique([characterId, achievementId])
}

model EconomyLog {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  currency    String // 'GOLD', 'EXP'
  amount      Int // can be negative for spent gold
  reason      String
  source      String // 'MISSION', 'ACHIEVEMENT', 'SHOP'
  createdAt   DateTime  @default(now())
}

model Tower {
  id          String   @id @default(uuid())
  name        String
  description String
  theme       String
  maxFloor    Int
  createdAt   DateTime @default(now())

  floors Floor[]
}

model Enemy {
  id          String  @id @default(uuid())
  name        String
  type        String // 'Beast', 'Undead', 'Machine', 'Spirit', 'Dragon', 'Titan', 'Shadow', 'Human'
  rarity      String // 'Common', 'Elite', 'Boss', 'Mythic'
  baseHp      Int
  baseAttack  Int
  baseDefense Int
  baseSpeed   Int
  image       String?

  bossFloors Floor[] @relation("FloorBoss")
}

model Floor {
  id               String  @id @default(uuid())
  towerId          String
  tower            Tower   @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber      Int
  recommendedPower Int
  minStrength      Int     @default(1)
  minKnowledge     Int     @default(1)
  minRecovery      Int     @default(1)
  minDiscipline    Int     @default(1)
  minFocus         Int     @default(1)
  minEndurance     Int     @default(1)
  bossId           String?
  boss             Enemy?  @relation("FloorBoss", fields: [bossId], references: [id], onDelete: SetNull)
  rewardPool       String // JSON-serialized string

  progress FloorProgress[]
}

model FloorProgress {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  floorId     String
  floor       Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  status      String // 'LOCKED', 'UNLOCKED', 'CLEARED', 'PERFECT'
  attempts    Int       @default(0)
  bestTime    Int?
  clearedAt   DateTime?

  @@unique([characterId, floorId])
}

model ItemDefinition {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // ItemType
  rarity      String   // ItemRarity
  icon        String
  sellValue   Int      @default(0)
  
  // Base Stats
  attack      Int      @default(0)
  defense     Int      @default(0)
  strength    Int      @default(0)
  knowledge   Int      @default(0)
  discipline  Int      @default(0)
  focus       Int      @default(0)
  endurance   Int      @default(0)
  recovery    Int      @default(0)
  
  passive     String?

  playerItems PlayerItem[]
  towerFloors TowerFloor[]
  shopItems   ShopItem[]
}

model PlayerItem {
  id               String         @id @default(uuid())
  characterId      String
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemDefinitionId String
  itemDefinition   ItemDefinition @relation(fields: [itemDefinitionId], references: [id], onDelete: Cascade)
  
  quantity         Int            @default(1)
  isEquipped       Boolean        @default(false)
  isLocked         Boolean        @default(false)
  isFavorite       Boolean        @default(false)
  
  acquiredAt       DateTime       @default(now())
  acquiredFrom     String?

  @@index([characterId, isEquipped])
}

model InventoryTransaction {
  id           String    @id @default(uuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  playerItemId String?
  
  type         String    // TransactionType
  quantity     Int
  source       String?
  createdAt    DateTime  @default(now())
}

model ExerciseDefinition {
  id               String             @id @default(uuid())
  name             String             @unique
  primaryMuscle    String
  secondaryMuscles String             @default("[]") // JSON-serialized list of secondary muscles, e.g. '["TRICEPS", "SHOULDERS"]'
  category         String             @default("HYPERTROPHY") // 'STRENGTH', 'HYPERTROPHY', 'ENDURANCE'
  instructions     String?
  equipment        String
  trackingMetrics  String             // e.g. "Weight, Reps"
  createdAt        DateTime           @default(now())

  standards        ExerciseStandard[]
  workoutSets      WorkoutSet[]
}

model ExerciseStandard {
  id              String             @id @default(uuid())
  exerciseId      String
  exercise        ExerciseDefinition @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sex             String             // 'M', 'F'
  bodyweightMin   Float
  bodyweightMax   Float
  rankE           Int
  rankD           Int
  rankC           Int
  rankB           Int
  rankA           Int
  rankS           Int
  rankSS          Int
  rankSSS         Int
}

model WorkoutSession {
  id              String       @id @default(uuid())
  characterId     String
  character       Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  date            DateTime     @default(now())
  durationSeconds Int?

  sets            WorkoutSet[]
}

model WorkoutSet {
  id              String             @id @default(uuid())
  sessionId       String
  session         WorkoutSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        ExerciseDefinition @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  weight          Float
  reps            Int
  rpe             Float?
  isPr            Boolean            @default(false)
  createdAt       DateTime           @default(now())

  @@index([sessionId])
}

model MuscleRecoveryState {
  id                String    @id @default(uuid())
  characterId       String
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  muscleGroup       String    // 'CHEST', 'BACK', 'LATS', 'TRAPS', 'SHOULDERS', 'BICEPS', 'TRICEPS', 'FOREARMS', 'ABS', 'OBLIQUES', 'QUADS', 'HAMSTRINGS', 'GLUTES', 'CALVES'
  initialFatigue    Float     @default(0.0) // 0.0 to 100.0
  lastTrainedAt     DateTime  @default(now())
  fullRecoveryHours Float     @default(48.0) // 48.0 for standard, 72.0 for heavy compound groups
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([characterId, muscleGroup])
}

model WeeklyBoss {
  id             String    @id @default(uuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name           String
  bossSprite     String?
  targetExercise String
  targetWeight   Float
  targetReps     Int
  currentDamage  Float     @default(0.0)
  rewards        String    // JSON-serialized rewards
  damageLogs     String?   @default("[]") // JSON-serialized combat damage logs
  isDefeated     Boolean   @default(false)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
}

model Title {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  icon             String?
  category         String   @default("Milestone") // 'Milestone', 'Tower', 'Habits', 'Special'
  statBonus        String?  // JSON e.g. '{"strength": 2, "recovery": 2}'
  powerMultiplier  Float    @default(1.0)
  requirementType  String?
  requirementValue Int?
  createdAt        DateTime @default(now())

  characterTitles  CharacterTitle[]
}

model CharacterTitle {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  titleId     String
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  unlockedAt  DateTime  @default(now())
  isEquipped  Boolean   @default(false)

  @@unique([characterId, titleId])
}

model ClassSpecialization {
  id               String   @id @default(uuid())
  name             String   @unique
  baseClass        String   // 'WARRIOR', 'MAGE', 'ASSASSIN', 'TANK', 'SHADOW_MONARCH', etc.
  tier             Int      @default(1) // 1 or 2
  requiredLevel    Int      @default(5)
  requiredStats    String?  // JSON string: {"strength": 30, "endurance": 20, ...}
  description      String?
  lore             String?  // Deep Solo-Leveling / Ascend lore chronicle
  icon             String?  // '/class_icons/icHunter.png'
  statBonus        String?  // JSON string: {"strength": 40, "endurance": 25, ...}
  powerMultiplier  Float    @default(1.20)
  passivePerk      String?  // Name of the passive perk
  passiveEffect    String?  // Detailed description of the perk

  characters       Character[]
  skills           SkillDefinition[]
}

model SkillDefinition {
  id                  String   @id
  name                String
  description         String?
  elementPath         String?  // Flame, Tempest, Earth, Tide, Ascension
  tier                Int      @default(1)
  maxLevel            Int      @default(5)
  skillType           String   // Active, Passive, Ultimate, Stance
  baseCostSP          Int      @default(1)
  statRequirements    String   // JSON string storing stats + prerequisite skills
  icon                String?
  specializationId    String?
  specialization      ClassSpecialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  
  playerSkills        PlayerSkill[]
}

model PlayerSkill {
  id                String          @id @default(uuid())
  characterId       String
  character         Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillDefinitionId String
  skillDefinition   SkillDefinition @relation(fields: [skillDefinitionId], references: [id], onDelete: Cascade)
  
  currentLevel      Int             @default(1)
  unlockedAt        DateTime        @default(now())

  @@unique([characterId, skillDefinitionId])
}

model TowerEnemy {
  id              String   @id @default(uuid())
  name            String
  level           Int
  hp              Int
  attack          Int
  defense         Int
  speed           Int
  weaknessStat    String?
  resistanceStat  String?
  icon            String?
  isBoss          Boolean  @default(false)

  towerFloors     TowerFloor[]
}

model TowerFloor {
  id                     String      @id @default(uuid())
  floorNumber            Int         @unique
  requiredPower          Int
  requiredStrength       Int         @default(1)
  requiredEndurance      Int         @default(1)
  requiredKnowledge      Int         @default(1)
  requiredRecovery       Int         @default(1)
  requiredFocus          Int         @default(1)
  requiredDiscipline     Int         @default(1)
  enemyId                String
  enemy                  TowerEnemy  @relation(fields: [enemyId], references: [id], onDelete: Cascade)
  isBoss                 Boolean     @default(false)
  goldReward             Int         @default(0)
  expReward              Int         @default(0)
  itemRewardDefinitionId String?
  itemRewardDefinition   ItemDefinition? @relation(fields: [itemRewardDefinitionId], references: [id], onDelete: SetNull)

  towerProgresses        TowerProgress[]
}

model TowerProgress {
  id                   String     @id @default(uuid())
  characterId          String
  character            Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  floorNumber          Int
  floor                TowerFloor @relation(fields: [floorNumber], references: [floorNumber], onDelete: Cascade)
  isCleared            Boolean    @default(false)
  attempts             Int        @default(0)
  bestClearTimeSeconds Int?
  clearedAt            DateTime?

  @@unique([characterId, floorNumber])
}

model Boss {
  id          String   @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  difficulty  String
  archetype   String?
  maxHp       Int
  currentHp   Int
  rewardGold  Int?
  rewardExp   Int?
  rewardTitle String?
  realWorldReward String?
  deadline    DateTime?
  status      String   @default("ACTIVE") // 'ACTIVE', 'DEFEATED', 'FAILED', 'ARCHIVED'
  createdAt   DateTime @default(now())

  phases      BossPhase[]
  activities  BossActivity[]
  damageLogs  BossDamageLog[]
}

model BossPhase {
  id         String @id @default(uuid())
  bossId     String
  boss       Boss   @relation(fields: [bossId], references: [id], onDelete: Cascade)
  name       String
  maxHp      Int
  orderIndex Int

  @@unique([bossId, orderIndex])
}

model BossActivity {
  id           String @id @default(uuid())
  bossId       String
  boss         Boss   @relation(fields: [bossId], references: [id], onDelete: Cascade)
  activityType String // 'HABIT', 'MISSION', 'WORKOUT'
  referenceId  String? // e.g. habitId or exerciseId
  damageValue  Int

  damageLogs   BossDamageLog[]
}

model BossDamageLog {
  id         String @id @default(uuid())
  bossId     String
  boss       Boss   @relation(fields: [bossId], references: [id], onDelete: Cascade)
  activityId String?
  activity   BossActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  damage     Int
  createdAt  DateTime @default(now())
}

model ShopItem {
  id            String         @id @default(uuid())
  itemId        String
  item          ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Cascade)
  currencyType  String         // 'GOLD', 'GEMS', 'TOWER_TOKENS'
  price         Int
  stock         Int?
  requiredLevel Int?
  requiredPower Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ActiveBuff {
  id               String    @id @default(uuid())
  characterId      String
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  buffType         String    // 'DOUBLE_EXP', 'DOUBLE_GOLD'
  multiplier       Float     @default(2.0)
  expiresAt        DateTime
  chargesRemaining Int?      @default(10)
  createdAt        DateTime  @default(now())
}

model SeasonPass {
  id           String      @id @default(uuid())
  seasonNumber Int         @default(1)
  title        String
  startDate    DateTime    @default(now())
  endDate      DateTime

  tiers        SeasonTier[]
  progresses   CharacterSeasonProgress[]
}

model SeasonTier {
  id            String     @id @default(uuid())
  seasonId      String
  season        SeasonPass @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tierNumber    Int
  requiredXp    Int
  freeReward    String     // JSON string
  premiumReward String     // JSON string
  freeIcon      String     // e.g. '/icons/Icon1.png'
  premiumIcon   String     // e.g. '/icons/Icon15.png'

  @@unique([seasonId, tierNumber])
}

model CharacterSeasonProgress {
  id                  String     @id @default(uuid())
  characterId         String
  character           Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  seasonId            String
  season              SeasonPass @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  passXp              Int        @default(0)
  claimedFreeTiers    String     @default("[]") // JSON string array
  claimedPremiumTiers String     @default("[]") // JSON string array
  isPremium           Boolean    @default(false)

  @@unique([characterId, seasonId])
}

model Egg {
  id             String    @id @default(uuid())
  name           String
  eggType        String    @default("ELEMENTAL") // 'ELEMENTAL', 'CYBER', 'VOID', 'SOLAR', 'ASTRAL', 'GLACIAL', 'NATURE', 'FROST'
  sprite         String    @default("/eggs/egg_1.png")
  rarity         String    @default("COMMON")    // 'COMMON', 'RARE', 'EPIC', 'LEGENDARY', 'HOLOGRAPHIC'
  targetSteps    Int       @default(5000)
  currentSteps   Int       @default(0)
  targetEnergy   Int       @default(5000)
  currentEnergy  Int       @default(0)
  status         String    @default("INCUBATING") // 'INCUBATING', 'READY_TO_HATCH', 'HATCHED'
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  hatchedBeastId String?
  hatchedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Beast {
  id               String    @id @default(uuid())
  name             String
  species          String
  element          String    @default("FIRE") // 'FIRE', 'FROST', 'VOID', 'CYBER', 'NATURE', 'HOLY', 'STORM'
  rarity           String    @default("COMMON") // 'COMMON', 'RARE', 'EPIC', 'LEGENDARY', 'HOLOGRAPHIC'
  spritePath       String    @default("/beasts/beast_1.png")
  passiveBuffType  String    @default("EXP_BOOST") // 'EXP_BOOST', 'GOLD_BOOST', 'STR_BOOST', 'AGI_BOOST', 'INT_BOOST', 'STRENGTH', 'KNOWLEDGE', 'DISCIPLINE', 'RECOVERY', 'FOCUS', 'ENDURANCE'
  passiveBuffValue Float     @default(5.0)
  statBonusType    String    @default("EXP_BOOST")
  statBonusValue   Float     @default(5.0)
  description      String?
  lore             String?
  level            Int       @default(1)
  accumulatedSteps Int       @default(0)
  stepUpgradeReq   Int       @default(5000)
  goldUpgradeReq   Int       @default(1000)
  isEquipped       Boolean   @default(false)
  characterId      String
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  unlockedAt       DateTime  @default(now())
}

model DailyStepLog {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stepCount   Int
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}
