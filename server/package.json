{
  "name": "ascend-os-server",
  "version": "1.0.0",
  "description": "Ascend OS Backend Engine",
  "main": "main.py",
  "scripts": {
    "build": "pip install -r requirements.txt && python build_server.py",
    "start": "uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log",
    "dev": "uvicorn main:app --reload --port 8000"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
